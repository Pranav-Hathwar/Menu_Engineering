# Copy this file to .env and fill in your values.

# --- Database ---
# SQLite (zero-setup local dev):
#   DATABASE_URL=sqlite:///./menumind.db
# PostgreSQL (production):
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/menumind

# --- Security ---
# Generate a strong value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
APP_NAME=MenuMind Pro
DEBUG=false
AUTO_CREATE_TABLES=true
MAX_UPLOAD_BYTES=10485760
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API.
# Add your production frontend URL here before deploying.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
