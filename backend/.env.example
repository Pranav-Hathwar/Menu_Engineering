# Copy this file to .env and fill in your values.

# --- Database ---
# SQLite (zero-setup local dev):
#   DATABASE_URL=sqlite:///./menumind.db
# PostgreSQL (production):
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/menumind

# --- Security ---
# Generate a strong value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
APP_NAME=MenuMind Pro
DEBUG=false
AUTO_CREATE_TABLES=true
MAX_UPLOAD_BYTES=10485760
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API.
# Add your production frontend URL here before deploying.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email auto-ingestion (POS daily report emails) ---
# 1. Point the POS's scheduled daily report at a dedicated inbox.
# 2. Put that inbox's address + app password below.
#    (Gmail: Google Account -> Security -> 2-Step Verification -> App passwords)
# 3. Set INGEST_ENABLED=true and restart the backend.
INGEST_ENABLED=false
INGEST_IMAP_HOST=imap.gmail.com
INGEST_IMAP_PORT=993
INGEST_EMAIL=PUT-THE-REPORT-INBOX-EMAIL-HERE
INGEST_EMAIL_PASSWORD=PUT-THE-APP-PASSWORD-HERE
# MenuMind account that owns the ingested data (defaults to the first user).
INGEST_OWNER_EMAIL=
# Restaurant the reports belong to.
INGEST_RESTAURANT_NAME=Mint Masala
# Optional: only accept report emails from these senders (comma-separated).
INGEST_ALLOWED_SENDERS=
INGEST_POLL_MINUTES=10
